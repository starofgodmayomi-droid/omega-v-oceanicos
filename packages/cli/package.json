{
  "name": "@omega-v/cli",
  "version": "0.2.0",
  "description": "Command line tool for the Ω∞v Oceanicos verification loop (C9)",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "omega-v": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "watch": "tsc --watch",
    "test": "cd ../.. && node --experimental-transform-types --import ./tests/helpers/jest-compat.mjs --test packages/cli/src/index.test.ts packages/cli/src/__tests__/*.test.ts packages/cli/src/cli-failures.test.ts packages/cli/src/scene-and-persistence-mutations.test.ts",
    "typecheck": "tsc --noEmit",
    "clean": "node ../../scripts/rimraf.cjs dist \"*.tsbuildinfo\""
  },
  "keywords": [
    "cli",
    "terminal",
    "verification",
    "oceanicos"
  ],
  "author": "Ω∞v Community",
  "license": "Apache-2.0",
  "dependencies": {}
}
