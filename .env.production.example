# Ω∞v Oceanicos production runtime configuration.
# Copy to a secret-managed environment; never commit real values.
NODE_ENV=production
API_PORT=5000
OMEGA_AUTH_MODE=required
OMEGA_SIGNING_KEY=replace-with-a-secret-at-least-32-characters
OMEGA_READ_TOKEN=replace-with-a-distinct-read-token
OMEGA_ADMIN_TOKEN=replace-with-a-distinct-admin-token
OMEGA_DB_PATH=/var/lib/omega-v/oceanicos.db
OMEGA_RUNTIME_STORE_PATH=/var/lib/omega-v/runtime.json
OMEGA_EVENT_LOG_PATH=/var/lib/omega-v/events.jsonl
OMEGA_PERSISTENCE=on
# Build-time frontend API origin. Use the public HTTPS API origin.
VITE_API_URL=https://api.example.com
# Optional operational policy declarations.
OMEGA_PERSISTENCE_RECOVERY_MODE=unavailable
OMEGA_PERSISTENCE_DELETION_MODE=operator-confirmed
OMEGA_PERSISTENCE_CUSTODY_MODE=unverified-local
OMEGA_PERSISTENCE_COORDINATION_MODE=local-single-process
