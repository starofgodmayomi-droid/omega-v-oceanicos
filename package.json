{
  "name": "omega-v-oceanicos",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "install:all": "pnpm install",
    "build": "pnpm --recursive run build",
    "typecheck": "pnpm --recursive run typecheck",
    "verify": "node -e \"const { executeOceanicosMaxExpansion } = require('./packages/mini/dist/index.js'); executeOceanicosMaxExpansion();\"",
    "test": "node --test tests/integration/max_compress_stack.e2e.test.ts",
    "test:e2e": "node --test tests/integration/max_compress_stack.e2e.test.ts",
    "start:api": "pnpm --filter api run start",
    "start:web": "pnpm --filter web run start"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=8.0.0"
  },
  "devDependencies": {
    "typescript": "^5.3.3",
    "@types/node": "^20.0.0"
  }
}
