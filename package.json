{
  "name": "omega-v-oceanicos",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "bin": {
    "oceanicos": "./bin/oceanicos.mjs"
  },
  "scripts": {
    "install:all": "pnpm install",
    "build": "pnpm --recursive run build",
    "typecheck": "pnpm --recursive run typecheck",
    "type-check": "pnpm typecheck",
    "lint": "pnpm typecheck",
    "format:check": "git diff --check",
    "audit": "node scripts/oceanicos-audit.mjs",
    "cli": "node bin/oceanicos.mjs",
    "oceanicos": "node bin/oceanicos.mjs",
    "mood": "node bin/oceanicos.mjs mood",
    "worker": "node scripts/oceanicos-worker.mjs",
    "worker:verify": "node scripts/oceanicos-worker.mjs --verify",
    "worker:continuous": "node scripts/oceanicos-worker.mjs --verify --continuous",
    "dev": "pnpm --filter api run dev",
    "dev:api": "pnpm --filter api run dev",
    "dev:web": "pnpm --filter web run dev",
    "start:api": "pnpm --filter api run start",
    "start:web": "pnpm --filter web run start",
    "smoke:api": "pnpm build && node scripts/smoke-api.cjs",
    "totality": "bash scripts/oceanicos-totality.sh",
    "verify": "pnpm run typecheck && pnpm run build && pnpm run test:fast && pnpm run test:integration",
    "verify:full": "pnpm run totality",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js --config jest.config.cjs --runInBand",
    "test:fast": "node --experimental-vm-modules node_modules/jest/bin/jest.js --config jest.config.cjs tests/unit --runInBand",
    "test:integration": "node --experimental-vm-modules node_modules/jest/bin/jest.js --config jest.config.cjs tests/integration --runInBand",
    "test:e2e": "node --experimental-vm-modules node_modules/jest/bin/jest.js --config jest.config.cjs tests/e2e --runInBand",
    "test:coverage": "node --experimental-vm-modules node_modules/jest/bin/jest.js --config jest.config.cjs --coverage --runInBand",
    "test:stack": "tsx --test tests/integration/max_compress_stack.e2e.test.ts",
    "test:worker": "node --experimental-strip-types --test ./tests/integration/worker-lifecycle.integration.test.ts",
    "test:mood": "pnpm --filter @omega-v/mood test",
    "docker:up": "docker compose up --build -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f"
  },
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=8.0.0"
  },
  "devDependencies": {
    "@jest/globals": "^29.7.0",
    "@types/jest": "^29.5.12",
    "@types/node": "^22.0.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.2",
    "ts-node": "^10.9.2",
    "tsx": "^4.19.2",
    "typescript": "^5.3.3"
  }
}
