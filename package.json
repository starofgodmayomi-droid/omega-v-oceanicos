{
  "name": "omega-v-oceanicos",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "scripts": {
    "install:all": "pnpm install",
    "build": "pnpm --recursive run build",
    "typecheck": "pnpm --recursive run build && pnpm --recursive run typecheck",
    "format:check": "git diff --check",
    "audit": "node scripts/oceanicos-audit.mjs",
    "validate:ci": "node scripts/validate-ci-contract.mjs",
    "validate:skills": "node scripts/validate-skill-contracts.mjs",
    "lint": "pnpm typecheck",
    "type-check": "pnpm typecheck",
    "verify": "pnpm build && node --input-type=module -e \"const { executeOceanicosMaxExpansion } = await import('./packages/mini/dist/index.js'); executeOceanicosMaxExpansion();\"",
    "predev": "pnpm build",
    "mood": "node bin/oceanicos.mjs mood",
    "worker": "node scripts/oceanicos-worker.mjs",
    "worker:verify": "node scripts/oceanicos-worker.mjs --verify",
    "worker:continuous": "node scripts/oceanicos-worker.mjs --verify --continuous",
    "test": "pnpm build && node --experimental-strip-types --test-concurrency=1 --test ./tests/integration/max_compress_stack.e2e.test.ts ./tests/integration/evolve-recompile.e2e.test.ts ./tests/integration/connector_admission.integration.test.ts ./tests/integration/connector_observation.integration.test.ts ./tests/integration/worker-lifecycle.integration.test.ts ./tests/integration/bounded-worker-script.integration.test.ts ./tests/integration/causal-memory.integration.test.ts ./tests/integration/api-pipeline-causal.integration.test.ts ./tests/integration/navigator_api.integration.test.ts ./tests/integration/omega_reality_verification.test.ts ./tests/integration/omega_distributed_coordination.test.ts ./tests/integration/oceanicos_operational_protocol.test.ts ./tests/integration/oreade_api.integration.test.ts ./tests/integration/mood_codex_api.integration.test.ts ./tests/integration/divergence_feed_api.integration.test.ts ./tests/integration/revocation-persistence.integration.test.ts ./tests/integration/remember_ledger_integrity.e2e.test.ts ./tests/integration/one-body-ecosystem.integration.test.ts ./tests/integration/value_navigator_api.integration.test.ts ./tests/integration/web-api-proxy.integration.test.ts ./tests/integration/ghcr-publish-authorization.integration.test.ts ./tests/integration/release-bundle.integration.test.ts ./tests/integration/apps-index-contract.integration.test.ts ./tests/integration/repo-inventory-contract.integration.test.ts ./apps/web/tests/oreade-submission.node-check.ts",
    "test:e2e": "pnpm build && node --experimental-strip-types --test-concurrency=1 --test ./tests/integration/max_compress_stack.e2e.test.ts ./tests/integration/evolve-recompile.e2e.test.ts ./tests/integration/connector_admission.integration.test.ts ./tests/integration/connector_observation.integration.test.ts ./tests/integration/worker-lifecycle.integration.test.ts ./tests/integration/bounded-worker-script.integration.test.ts ./tests/integration/causal-memory.integration.test.ts ./tests/integration/api-pipeline-causal.integration.test.ts ./tests/integration/navigator_api.integration.test.ts ./tests/integration/omega_reality_verification.test.ts ./tests/integration/omega_distributed_coordination.test.ts ./tests/integration/oceanicos_operational_protocol.test.ts ./tests/integration/oreade_api.integration.test.ts ./tests/integration/mood_codex_api.integration.test.ts ./tests/integration/divergence_feed_api.integration.test.ts ./tests/integration/revocation-persistence.integration.test.ts ./tests/integration/remember_ledger_integrity.e2e.test.ts ./tests/integration/one-body-ecosystem.integration.test.ts ./tests/integration/value_navigator_api.integration.test.ts ./tests/integration/web-api-proxy.integration.test.ts ./tests/integration/ghcr-publish-authorization.integration.test.ts ./tests/integration/release-bundle.integration.test.ts ./tests/integration/apps-index-contract.integration.test.ts ./tests/integration/repo-inventory-contract.integration.test.ts ./apps/web/tests/oreade-submission.node-check.ts",
    "test:worker": "node --experimental-strip-types --test ./tests/integration/worker-lifecycle.integration.test.ts",
    "test:mood": "pnpm --filter @omega-v/mood test",
    "totality": "bash scripts/oceanicos-totality.sh",
    "verify:full": "pnpm run totality",
    "smoke:api": "pnpm build && node scripts/smoke-api.cjs",
    "test:packages": "pnpm run test:worker",
    "test:coverage": "pnpm build && rm -rf coverage && mkdir -p coverage && node --experimental-strip-types --experimental-test-coverage --test-concurrency=1 --test-reporter=lcov --test-reporter-destination=coverage/lcov.info --test ./tests/integration/max_compress_stack.e2e.test.ts ./tests/integration/connector_admission.integration.test.ts ./tests/integration/connector_observation.integration.test.ts ./tests/integration/worker-lifecycle.integration.test.ts ./tests/integration/causal-memory.integration.test.ts ./tests/integration/api-pipeline-causal.integration.test.ts ./tests/integration/navigator_api.integration.test.ts ./tests/integration/omega_reality_verification.test.ts ./tests/integration/omega_distributed_coordination.test.ts ./tests/integration/oceanicos_operational_protocol.test.ts ./tests/integration/revocation-persistence.integration.test.ts ./tests/integration/remember_ledger_integrity.e2e.test.ts ./tests/integration/value_navigator_api.integration.test.ts",
    "cli": "node bin/oceanicos.mjs",
    "oceanicos": "node bin/oceanicos.mjs",
    "start:api": "pnpm --filter api run start",
    "start:web": "pnpm --filter web run start",
    "dev": "node bin/dev-server.mjs",
    "dev:api": "pnpm --filter api run dev",
    "dev:web": "pnpm --filter web run dev",
    "docker:up": "docker compose up --build -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "test:contract": "pnpm --filter @oceanicos/types build && node --experimental-strip-types --test ./tests/integration/navigator_contract.integration.test.ts"
  },
  "bin": {
    "oceanicos": "./bin/oceanicos.mjs"
  },
  "engines": {
    "node": ">=22.0.0",
    "pnpm": "10.34.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3"
  }
}
