{
  "name": "omega-v-oceanicos",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "install:all": "pnpm install",
    "build": "pnpm --recursive run build",
    "typecheck": "pnpm --recursive run build && pnpm --recursive run typecheck",
    "format:check": "git diff --check",
    "audit": "node scripts/oceanicos-audit.mjs",
    "lint": "pnpm typecheck",
    "type-check": "pnpm typecheck",
    "verify": "pnpm build && node -e \"const { executeOceanicosMaxExpansion } = require('./packages/mini/dist/index.js'); executeOceanicosMaxExpansion();\"",
    "predev": "pnpm build",
    "mood": "node bin/oceanicos.mjs mood",
    "worker": "node scripts/oceanicos-worker.mjs",
    "worker:verify": "node scripts/oceanicos-worker.mjs --verify",
    "worker:continuous": "node scripts/oceanicos-worker.mjs --verify --continuous",
    "test": "pnpm build && node --experimental-strip-types --test-concurrency=1 --test ./tests/integration/max_compress_stack.e2e.test.ts ./tests/integration/worker-lifecycle.integration.test.ts ./tests/integration/bounded-worker-script.integration.test.ts ./tests/integration/causal-memory.integration.test.ts ./tests/integration/api-pipeline-causal.integration.test.ts ./tests/integration/omega_reality_verification.test.ts ./tests/integration/omega_distributed_coordination.test.ts ./tests/integration/oceanicos_operational_protocol.test.ts",
    "test:e2e": "pnpm build && node --experimental-strip-types --test-concurrency=1 --test ./tests/integration/max_compress_stack.e2e.test.ts ./tests/integration/worker-lifecycle.integration.test.ts ./tests/integration/bounded-worker-script.integration.test.ts ./tests/integration/causal-memory.integration.test.ts ./tests/integration/api-pipeline-causal.integration.test.ts ./tests/integration/omega_reality_verification.test.ts ./tests/integration/omega_distributed_coordination.test.ts ./tests/integration/oceanicos_operational_protocol.test.ts",
    "test:worker": "node --experimental-strip-types --test ./tests/integration/worker-lifecycle.integration.test.ts",
    "test:mood": "pnpm --filter @omega-v/mood test",
    "totality": "bash scripts/oceanicos-totality.sh",
    "verify:full": "pnpm run totality",
    "smoke:api": "pnpm build && node scripts/smoke-api.cjs",
    "test:packages": "pnpm run test:worker",
    "test:coverage": "pnpm build && rm -rf coverage && mkdir -p coverage && node --experimental-strip-types --experimental-test-coverage --test-concurrency=1 --test-reporter=lcov --test-reporter-destination=coverage/lcov.info --test ./tests/integration/max_compress_stack.e2e.test.ts ./tests/integration/worker-lifecycle.integration.test.ts ./tests/integration/causal-memory.integration.test.ts ./tests/integration/api-pipeline-causal.integration.test.ts ./tests/integration/omega_reality_verification.test.ts ./tests/integration/omega_distributed_coordination.test.ts ./tests/integration/oceanicos_operational_protocol.test.ts",
    "cli": "node bin/oceanicos.mjs",
    "oceanicos": "node bin/oceanicos.mjs",
    "start:api": "pnpm --filter api run start",
    "start:web": "pnpm --filter web run start",
    "dev": "node bin/dev-server.mjs",
    "dev:api": "pnpm --filter api run dev",
    "dev:web": "pnpm --filter web run dev",
    "docker:up": "docker compose up --build -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f"
  },
  "bin": {
    "oceanicos": "./bin/oceanicos.mjs"
  },
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=10.0.0"
  },
  "devDependencies": {
    "@omega-v/agents": "workspace:*",
    "@omega-v/amm": "workspace:*",
    "@omega-v/analytics": "workspace:*",
    "@oceanicos/attestation": "workspace:*",
    "@omega-v/attestor": "workspace:*",
    "@omega-v/auth": "workspace:*",
    "@omega-v/benchmark": "workspace:*",
    "@omega-v/bridge": "workspace:*",
