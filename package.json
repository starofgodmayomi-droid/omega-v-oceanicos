    "@omega-v/da": "workspace:*",
    "@omega-v/dht": "workspace:*",
    "@omega-v/dispute": "workspace:*",
    "@omega-v/dissensus": "workspace:*",
    "@omega-v/edge": "workspace:*",
    "@omega-v/enclave": "workspace:*",
    "@omega-v/evidence": "workspace:*",
    "@omega-v/evm": "workspace:*",
    "@omega-v/evolution": "workspace:*",
    "@omega-v/federation": "workspace:*",
    "@omega-v/friction": "workspace:*",
    "@omega-v/gateway": "workspace:*",
    "@omega-v/governance": "workspace:*",
    "@omega-v/governor": "workspace:*",
    "@omega-v/graph": "workspace:*",
    "@omega-v/green": "workspace:*",
    "@omega-v/human": "workspace:*",
    "@omega-v/intent": "workspace:*",
    "@omega-v/ir": "workspace:*",
    "@omega-v/kernel": "workspace:*",
    "@omega-v/learning": "workspace:*",
    "@omega-v/lexicon": "workspace:*",
    "@omega-v/mempool": "workspace:*",
    "@omega-v/mesh": "workspace:*",
    "@oceanicos/mini": "workspace:*",
    "@omega-v/mood": "workspace:*",
    "@omega-v/notary": "workspace:*",
    "@oceanicos/observer": "workspace:*",
    "@omega-v/oracle": "workspace:*",
    "@omega-v/orchestrator": "workspace:*",
    "@omega-v/pipeline": "workspace:*",
    "@omega-v/policy": "workspace:*",
    "@omega-v/registry": "workspace:*",
    "@omega-v/relay": "workspace:*",
    "@oceanicos/remember": "workspace:*",
    "@omega-v/replay": "workspace:*",
    "@omega-v/reputation": "workspace:*",
    "@omega-v/rollup": "workspace:*",
    "@omega-v/runtime": "workspace:*",
    "@omega-v/sandbox": "workspace:*",
    "@omega-v/scheduler": "workspace:*",
    "@omega-v/sdk": "workspace:*",
    "@omega-v/security": "workspace:*",
    "@omega-v/sequencer": "workspace:*",
    "@omega-v/sharding": "workspace:*",
    "@omega-v/staking": "workspace:*",
    "@omega-v/store": "workspace:*",
    "@omega-v/telemetry": "workspace:*",
    "@oceanicos/types": "workspace:*",
    "@types/node": "^22.0.0",
    "@omega-v/vaas": "workspace:*",
    "@omega-v/vault": "workspace:*",
    "@oceanicos/verification": "workspace:*",
    "@omega-v/webhook": "workspace:*",
    "@omega-v/worker": "workspace:*",
    "@omega-v/zk": "workspace:*",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  }
}
