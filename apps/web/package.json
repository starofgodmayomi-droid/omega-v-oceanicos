    "@testing-library/react": "16.3.0",
    "@testing-library/user-event": "14.6.1",
    "@types/jest": "30.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "cross-env": "10.1.0",
    "jest": "30.5.2",
    "jest-environment-jsdom": "30.5.2",
    "ts-jest": "29.4.14",
    "vite": "^8.3.2"
  }
