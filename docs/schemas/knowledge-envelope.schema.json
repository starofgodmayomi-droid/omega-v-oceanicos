{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/starofgodmayomi-droid/omega-v-oceanicos/blob/main/docs/schemas/knowledge-envelope.schema.json",
  "title": "OceanicOS Public-Safe Knowledge Envelope",
  "description": "Metadata-only contract for sanitized knowledge and requirements derived from connected knowledge sources. Raw private source content is intentionally excluded.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "kind",
    "summary",
    "state",
    "source",
    "capturedAt",
    "visibility",
    "policy",
    "relations",
    "evidence"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "kind": {
      "type": "string",
      "enum": [
        "principle",
        "concept",
        "requirement",
        "proposal",
        "decision",
        "observation",
        "implementation",
        "verification",
        "risk",
        "domain",
        "unknown"
      ]
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000,
      "description": "Sanitized summary; never put raw private source text here."
    },
    "state": {
      "type": "string",
      "enum": [
        "IDEA",
        "SPECIFIED",
        "AUTHORIZED",
        "EXECUTED",
        "OBSERVED",
        "TESTED",
        "VERIFIED",
        "DEPLOYED",
        "REVENUE_EVIDENCED",
        "PROFIT_EVIDENCED",
        "UNKNOWN",
        "DIVERGENT",
        "BLOCKED",
        "NOT_EXECUTED"
      ]
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "system",
        "reference"
      ],
      "properties": {
        "system": {
          "type": "string",
          "enum": [
            "notion",
            "github",
            "runtime",
            "human",
            "external"
          ]
        },
        "reference": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500,
          "description": "Stable URL or source ID; redact private IDs before public release."
        },
        "revision": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 200
        },
        "capturedAt": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        }
      }
    },
    "capturedAt": {
      "type": "string",
      "format": "date-time"
    },
    "contentHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$",
      "description": "Optional SHA-256 of source content, computed only within authorized processing scope."
    },
    "owner": {
      "type": "string",
      "maxLength": 200
    },
    "visibility": {
      "type": "string",
      "enum": [
        "public",
        "internal",
        "private",
        "restricted"
      ]
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reviewedForPublicRelease",
        "containsRawSourceContent"
      ],
      "properties": {
        "reviewedForPublicRelease": {
          "type": "boolean"
        },
        "containsRawSourceContent": {
          "const": false
        },
        "sensitivity": {
          "type": "string",
          "enum": [
            "none",
            "reviewed",
            "restricted",
            "unknown"
          ]
        },
        "approvalReference": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 300
        }
      }
    },
    "relations": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "type",
          "targetId"
        ],
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "supports",
              "contradicts",
              "duplicates",
              "depends_on",
              "implements",
              "supersedes",
              "derived_from",
              "related_to"
            ]
          },
          "targetId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          }
        }
      }
    },
    "supersedes": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "string",
        "maxLength": 200
      }
    },
    "evidence": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "type",
          "status"
        ],
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "source",
              "test",
              "ci",
              "runtime",
              "review",
              "deployment",
              "business_metric"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "PRESENT",
              "MISSING",
              "UNKNOWN",
              "DIVERGENT"
            ]
          },
          "reference": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 500
          },
          "observedAt": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "note": {
            "type": "string",
            "maxLength": 1000
          }
        }
      }
    },
    "acceptance": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "type": "string",
        "maxLength": 1000
      }
    },
    "nextAction": {
      "type": "string",
      "maxLength": 1000
    },
    "tags": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "type": "string",
        "maxLength": 100
      }
    }
  }
}
