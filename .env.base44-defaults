# Base44 dev-mode defaults — local-only placeholders so the app boots without credentials.
# Real secrets (if any) are delivered via /run/base44/app.env and override these.

# API
NODE_ENV=development
API_PORT=5000
OMEGA_AUTH_MODE=local
OMEGA_ALLOW_UNSIGNED_CYCLE=false
OMEGA_SIGNING_KEY=base44-dev-signing-key-replace-in-production-32chars
OMEGA_READ_TOKEN=base44-dev-read-token
OMEGA_ADMIN_TOKEN=base44-dev-admin-token
