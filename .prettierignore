# Build output and dependencies
dist/
node_modules/
coverage/

# Lockfiles are generated; reformatting them creates spurious diffs and
# defeats `pnpm install --frozen-lockfile`.
pnpm-lock.yaml

# TypeScript build artifacts committed for package consumers; source is the
# formatted contract and these files are regenerated by the package build.
packages/*/src/index.d.ts
packages/*/src/index.js
packages/*/src/index.d.ts.map
packages/*/src/index.js.map

# Skills are supplied artifacts, preserved exactly as received.
#
# Reformatting one would change a file this repository did not author and
# break the hash recorded alongside it, which is the only thing that lets
# an installed skill be checked against its source. Lineage over tidiness.
.claude/skills/
