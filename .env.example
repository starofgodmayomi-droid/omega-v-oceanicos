# ══════════════════════════════════════════════════════════════════════════════
# Ω∞v OCEANICOS — ENVIRONMENT CONFIGURATION BLUEPRINT
# ══════════════════════════════════════════════════════════════════════════════

# ─── API Gateway ─────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000
HOST=0.0.0.0
LEDGER_PATH=./data/oceanicos.jsonl

# ─── Cryptographic Attestation Security ──────────────────────────────────────
# Mandatory fail-closed signing secret (minimum 16 characters)
OMEGA_SIGNING_KEY=replace-with-a-local-secret-at-least-16-characters

# ─── Local AI Inference Engine (Ollama) ───────────────────────────────────────
# Local Ollama HTTP service endpoint (supports phi3:mini, llama3:8b)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=phi3:mini
OLLAMA_KEEP_ALIVE=24h

# ─── Dense Vector Memory Engine (Qdrant) ─────────────────────────────────────
# Local Qdrant HTTP REST API endpoint (cosine similarity, 384 dimensions)
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=oceanicos_blocks

# ─── Metaphysical Invariant Switches ─────────────────────────────────────────
OMEGA_MODE=MAX_FLUID
PIDGIN_ENGINE=ON
HIGH_LOW_ALIGN=TRUE
