# Ω∞v Oceanicos — Environment Configuration Template
# Copy to .env and fill in production values
# NEVER commit .env to source control

# ─── API Server ───────────────────────────────────────────────────────────────
API_PORT=3000
NODE_ENV=development
# Unsigned /v1/cycle is disabled by default; enable only for local development.
OMEGA_ALLOW_UNSIGNED_CYCLE=false

# ─── Signing / Attestation ────────────────────────────────────────────────────
# Required for /v1/attest; use at least 32 random bytes and never commit it.
OMEGA_SIGNING_KEY=change-me-in-production-use-a-32-byte-random-hex-string

# ─── Verification Config ──────────────────────────────────────────────────────
# Maximum number of verification rules per engine instance
OMEGA_V_MAX_RULES=100
# Response time threshold for health-check rules (ms)
OMEGA_V_RESPONSE_TIME_THRESHOLD=100
