# ══════════════════════════════════════════════════════════════════════════════
# Ω∞v OCEANICOS — ENVIRONMENT CONFIGURATION BLUEPRINT
# ══════════════════════════════════════════════════════════════════════════════

# ─── API Server / Gateway ───────────────────────────────────────────────────
PORT=5000
API_PORT=5000
HOST=0.0.0.0
NODE_ENV=development
LEDGER_PATH=./data/oceanicos.jsonl
OMEGA_DB_PATH=./oceanicos.db

# ─── API Authorization & Security ───────────────────────────────────────────
# Use required for network-exposed deployments; local permits local development.
OMEGA_AUTH_MODE=local
OMEGA_READ_TOKEN=change-me-to-a-read-only-bearer-token
OMEGA_ADMIN_TOKEN=change-me-to-a-distinct-admin-bearer-token

# Unsigned /v1/cycle is disabled by default; enable only for local development.
OMEGA_ALLOW_UNSIGNED_CYCLE=true

# Mandatory fail-closed signing secret (minimum 32 characters in production)
OMEGA_SIGNING_KEY=change-me-in-production-use-a-32-byte-random-hex-string

# ─── Reusable Security Engines ─────────────────────────────────────────────
OMEGA_AUTH_MASTER_SECRET=change-me-in-production-use-a-32-byte-random-hex-string
OMEGA_SECURITY_KEY=change-me-in-production-use-a-32-byte-random-hex-string
OMEGA_GATEWAY_SIGNING_KEY=change-me-in-production-use-a-32-byte-random-hex-string

# ─── Local AI Inference Engine (Ollama) ───────────────────────────────────
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=phi3:mini
OLLAMA_KEEP_ALIVE=24h

# ─── Dense Vector Memory Engine (Qdrant) ─────────────────────────────────
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=oceanicos_blocks

# ─── Metaphysical Invariant Switches ─────────────────────────────────────
OMEGA_MODE=MAX_FLUID
PIDGIN_ENGINE=ON
HIGH_LOW_ALIGN=TRUE
