# Local-first Compose template. Copy to .env and replace every placeholder.
# Do not commit .env or reuse these placeholders as secrets.

# Host binding defaults keep the UI/API local until exposure is deliberate.
API_BIND_ADDRESS=127.0.0.1
WEB_BIND_ADDRESS=127.0.0.1

# Qdrant and Ollama have fixed 127.0.0.1 host bindings in docker-compose.yml.
# Compose services still communicate with them over the private Compose network.

# Required API credentials: replace all three with distinct random values.
# Use at least 32 random bytes for the signing key.
OMEGA_SIGNING_KEY=REPLACE_WITH_AT_LEAST_32_RANDOM_BYTES
OMEGA_READ_TOKEN=REPLACE_WITH_A_UNIQUE_RANDOM_READ_TOKEN
OMEGA_ADMIN_TOKEN=REPLACE_WITH_A_DIFFERENT_RANDOM_ADMIN_TOKEN

# Exact local web origin; update deliberately for a reviewed custom deployment.
OMEGA_CORS_ORIGINS=http://localhost:3000
# Public browser API path. Keep this relative so the production web gateway owns credentials.
# Never put API bearer tokens in VITE_*.
VITE_API_URL=/api

# Optional bounded resource and runtime settings.
OMEGA_DB_PATH=/app/data/oceanicos.db
OMEGA_MODE=MAX_FLUID
CPU_LIMIT=2.0
MEM_LIMIT=2G
OLLAMA_MEM_LIMIT=8G
PIDGIN_ENGINE=ON
