# Copy to .env before running docker compose.
# Use unique local-only values; never commit real credentials.
OMEGA_SIGNING_KEY=replace-with-a-local-signing-key-at-least-32-characters
OMEGA_READ_TOKEN=replace-with-a-local-read-token
OMEGA_ADMIN_TOKEN=replace-with-a-different-local-admin-token
OMEGA_OIDC_ISSUER=https://your-tenant.us.auth0.com/
OMEGA_OIDC_AUDIENCE=replace-with-the-oceanicos-api-identifier
OMEGA_OIDC_JWKS_URI=https://your-tenant.us.auth0.com/.well-known/jwks.json
OMEGA_CONNECTOR_APPROVER_SUBJECT=replace-with-subject-from-a-verified-access-token
OMEGA_DB_PATH=/app/data/oceanicos.db
OMEGA_MODE=MAX_FLUID
PIDGIN_ENGINE=ON
CPU_LIMIT=2.0
MEM_LIMIT=2G
OLLAMA_MEM_LIMIT=8G
VITE_AUTH0_DOMAIN=your-tenant.us.auth0.com
VITE_AUTH0_CLIENT_ID=replace-with-spa-client-id
VITE_AUTH0_AUDIENCE=replace-with-the-oceanicos-api-identifier
